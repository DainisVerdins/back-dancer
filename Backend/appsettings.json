{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../logs/webapi-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenLifetimeMinutes": 20,
    "RefreshTokenLifetimeDays": 2
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=D:\\Projects\\back-dancer\\Backend\\DB\\SQLLiteDatabase.db"
  },
  "InitialUserCredentials": {
    "UserName": "",
    "Password": "",
    "Email": ""
  },

  "DomainSettings": {
    "ApplicationDomain": "http://localhost:5117",
    "FrontendDomain": "http://localhost:3000"
  },
  "CallBackUris": {
    "ConfirmPasswordChangeUri": "confirm-password",
    "InvitePersonToJoinOrganizationUri": "invite"
  }

}
